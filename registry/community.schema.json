{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cgold9820-dotcom/Flowgit/registry/community.schema.json",
  "title": "Flowgit community template registry",
  "description": "A JSON array of community templates. The checker that enforces this lives in packages/cli/src/registry.ts (validateCommunityRegistry). 社区模板登记：一个 JSON 数组。检查逻辑在 packages/cli/src/registry.ts 的 validateCommunityRegistry。",
  "type": "array",
  "items": { "$ref": "#/$defs/entry" },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en"],
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "git", "author", "tags", "language", "license"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable id used as flowgit init -t <id>."
        },
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "git": {
          "type": "string",
          "minLength": 1,
          "description": "Git URL. A repository subdirectory is #path=<subdir>, for example https://github.com/org/repo.git#path=examples/agent-page."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "Optional branch or tag. Omit to use the repository default."
        },
        "author": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "language": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["zh", "en"] }
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "description": "A clear license name, for example Apache-2.0 or MIT."
        }
      }
    }
  }
}
