{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flowgit timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "width", "height", "fps", "duration", "clips"],
  "properties": {
    "format": { "const": "flowgit/timeline" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "duration": { "type": "number", "minimum": 0 },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["fade", "none"] },
        "duration": { "type": "number", "minimum": 0 }
      }
    },
    "voice": { "$ref": "#/$defs/audio" },
    "music": { "$ref": "#/$defs/audio" },
    "captionStyle": { "type": "object" },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start", "duration", "source"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["image", "video", "card"] },
              "path": { "type": "string", "minLength": 1 }
            }
          },
          "caption": { "type": "string" },
          "narration": { "type": "string" },
          "motion": { "enum": ["zoom-in", "zoom-out", "none"] }
        }
      }
    }
  },
  "$defs": {
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "volume": { "type": "number", "minimum": 0, "maximum": 2 }
      }
    }
  }
}
