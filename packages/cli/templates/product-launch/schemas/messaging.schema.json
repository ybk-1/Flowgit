{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "定位和信息 / Positioning and messaging",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alternatives",
    "attributes",
    "bestFit",
    "category",
    "statement",
    "headline",
    "subhead",
    "pillars",
    "boilerplate",
    "tier",
    "claims"
  ],
  "properties": {
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attributes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attribute",
          "value"
        ],
        "properties": {
          "attribute": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "bestFit": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "subhead": {
      "type": "string",
      "minLength": 1
    },
    "pillars": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "message",
          "proof"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "proof": {
            "type": "string"
          }
        }
      }
    },
    "boilerplate": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "why"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "enum": [
            1,
            2,
            3
          ]
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "source"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
