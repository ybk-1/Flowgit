{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Column profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "rowCount", "dateRange", "columns"],
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "rowCount": { "type": "integer", "minimum": 1 },
    "dateRange": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "string", "minLength": 1 },
            "max": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "missing", "distinct", "min", "max", "mean", "median", "dateRange"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["date", "number", "string"] },
          "missing": { "type": "integer", "minimum": 0 },
          "distinct": { "type": "integer", "minimum": 0 },
          "min": { "type": ["string", "number", "null"] },
          "max": { "type": ["string", "number", "null"] },
          "mean": { "type": ["number", "null"] },
          "median": { "type": ["string", "number", "null"] },
          "dateRange": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["min", "max"],
                "properties": {
                  "min": { "type": "string", "minLength": 1 },
                  "max": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
