{
  "name": "@flowgit/core",
  "version": "0.1.0",
  "description": "Flowgit core: flow.json schema, validation, run history and stage executors.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgold9820-dotcom/Flowgit.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cgold9820-dotcom/Flowgit#readme",
  "bugs": {
    "url": "https://github.com/cgold9820-dotcom/Flowgit/issues"
  },
  "keywords": [
    "flowgit",
    "workflow",
    "flow",
    "pipeline",
    "llm",
    "agent",
    "ai"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./schema/flow.schema.json": "./schema/flow.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/gen-schema.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/copy-license.mjs",
    "check:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.17.1",
    "diff": "^9.0.0",
    "openai": "^6.49.0",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
