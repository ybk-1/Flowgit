{
  "name": "@flowgit/app",
  "version": "0.1.0",
  "private": true,
  "description": "Flowgit in a browser: the board as a static site, with flows and keys on the user's own device. 网页版看板：纯静态网站，流程和 key 都留在用户自己的设备上。",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.4",
    "@flowgit/core": "workspace:*",
    "@flowgit/web": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.25.12"
  }
}
