{
  "name": "@flowgit/web",
  "version": "0.1.0",
  "description": "Flowgit local web board: view, edit, add and remove stages, run them, fill in flow inputs, browse, compare and restore history, or switch to a flow graph, served by node:http on 127.0.0.1. 本机网页看板：查看、修改、新增和删除阶段，运行阶段，填写流程输入，查看历史、对比和回退，或切换到流程图。",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgold9820-dotcom/Flowgit.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/cgold9820-dotcom/Flowgit#readme",
  "bugs": {
    "url": "https://github.com/cgold9820-dotcom/Flowgit/issues"
  },
  "keywords": [
    "flowgit",
    "workflow",
    "flow",
    "board",
    "kanban"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@flowgit/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
